# Copy to cloud.env AFTER creating your GCP project. No inline comments on values.
CLOUD_PROVIDER=gcp
PROJECT_ID=YOUR_PROJECT_ID
REGION=asia-southeast1
BLOB_URI=gs://YOUR_UNIQUE_BUCKET/itcs355
CONTAINER_REGISTRY=asia-southeast1-docker.pkg.dev/YOUR_PROJECT_ID/itcs355
MLFLOW_TRACKING_URI=https://YOUR_REACHABLE_MLFLOW_SERVER
MODEL_REGISTRY_NAME=itcs355-lab2
IDENTITY_REF=lab2-trainer@YOUR_PROJECT_ID.iam.gserviceaccount.com
SERVING_IMAGE_URI=YOUR_SERVING_IMAGE@sha256:YOUR_DIGEST
BUDGET_LIMIT_THB=150
