# Same Python major/minor as the validated GCP lock file.
FROM python:3.12-slim
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 PYTHONPATH=/app GIT_PYTHON_REFRESH=quiet
WORKDIR /app
COPY requirements-gcp.txt ./
RUN pip install --no-cache-dir -r requirements-gcp.txt && useradd --create-home --uid 10001 runner
COPY --chown=runner:runner src/ ./src/
COPY --chown=runner:runner cloudlayer/ ./cloudlayer/
COPY --chown=runner:runner scripts/ ./scripts/
RUN mkdir -p /app/reports /app/data && chown runner:runner /app/reports /app/data
USER runner
ENTRYPOINT ["python", "-m", "src.train"]
CMD ["--n-estimators", "200", "--max-depth", "8"]
